# PostgreSQL (docker compose exposes 5433 on host)
DATABASE_URL=postgresql+psycopg://bfs_bot:bfs_bot@localhost:5433/bfs_bot

# Named C001–C007 rows plus filler customers for load testing
SEED_CUSTOMER_COUNT=200

# Signed cookie secret for demo login sessions (change in shared environments)
SESSION_SECRET=bfs-bot-local-dev-session-secret

# Optional OpenAI-compatible LLM endpoint.
# Leave LLM_API_KEY empty to use the deterministic offline adapter.
# Groq example:
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=offline-demo
